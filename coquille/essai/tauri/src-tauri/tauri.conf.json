{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vocabulaire",
  "version": "4.1.0",
  "identifier": "fr.franckvarault.vocabulaire",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vocabulaire",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Franck VARAULT",
    "copyright": "© 2026 Franck VARAULT",
    "category": "Education",
    "shortDescription": "Vocabulaire",
    "longDescription": "Vocabulaire — séances de vocabulaire par thème pour le CP et le CE1. Conçu par Franck VARAULT.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  }
}
